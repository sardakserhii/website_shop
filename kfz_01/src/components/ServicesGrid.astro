---
import texts from "../data/texts.de.json";
---

<section id="leistungen" class="section bg-[#F3F4F6]">
    <div class="container">
        <h2 class="h2 mb-8 text-[#101C26]">{texts.services.title}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                texts.services.items.map(([t, d]) => (
                    <div class="card p-5">
                        <div class="font-semibold">{t}</div>
                        <div class="text-white/70 text-sm mt-1">{d}</div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

---
import texts from "../data/texts.de.json";
---

<section class="section bg-[#F3F4F6]">
    <div class="container">
        <h2 class="h2 mb-8 text-[#101C26]">{texts.showcase.title}</h2>
        <div class="grid md:grid-cols-3 gap-6">
            {
                texts.showcase.cards.map(([t, d, img]) => (
                    <div class="card">
                        <div class=" bg-white/5 w-full h-48 flex items-center justify-center overflow-hidden rounded-t-lg">
                            <img src={`/${img}`} alt={t} />
                        </div>
                        <div class="p-5">
                            <div class="font-semibold">{t}</div>
                            <div class="text-white/70 text-sm mt-1">{d}</div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

---
import { site } from "../config/site";
import texts from "../data/texts.de.json";
const t = texts.footer;
---
<footer class="bg-neutral-100 border-t border-neutral-200 mt-16">
  <div class="container grid md:grid-cols-3 gap-8 py-12">
    <div>
      <div class="font-extrabold text-xl">Primal<span class="text-[color:var(--brand)]">Training</span></div>
      <p class="mt-3 text-sm text-neutral-700">Berlin • {site.address.street}, {site.address.postalCode} {site.address.city}</p>
    </div>
    <div>
      <h4 class="font-bold mb-2">{t.contact}</h4>
      <ul class="space-y-1 text-sm">
        <li><a href={"mailto:" + site.contacts.email} class="hover:opacity-70">{site.contacts.email}</a></li>
        <li><a href={"tel:" + site.contacts.phone.replace(/\s+/g,'')} class="hover:opacity-70">{site.contacts.phone}</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-bold mb-2">{t.opening}</h4>
      <ul class="space-y-1 text-sm">
        {site.openingHours.map((h) => (<li>{h}</li>))}
      </ul>
      <h4 class="font-bold mt-4 mb-2">{t.social}</h4>
      <ul class="space-y-1 text-sm">
        <li><a href={site.social.instagram} target="_blank" class="hover:opacity-70">Instagram</a></li>
        <li><a href={site.social.tiktok} target="_blank" class="hover:opacity-70">TikTok</a></li>
      </ul>
    </div>
  </div>
</footer>

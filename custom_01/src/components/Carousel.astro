---
import { Icon } from "astro-icon/components";
---

<!-- section with title, descrioption, 4 list title and rounded button "Discover more" -->
<section
    class="w-auto mx-auto my-16 flex flex-col md:flex-row items-stretch justify-center gap-12 px-4"
>
    <div class="order-1">
        <img src="/carousel_img.png" alt="" />
    </div>
    <div class="flex items-center">
        <div class="text-center px-4 flex flex-col justify-between h-full">
            <h2 class="font-mono font-bold text-3xl md:text-4xl">
                Why Choose Our Product
            </h2>
            <p class="mt-4 font-mono text-lg md:text-xl text-gray-700">
                Discover the benefits that set us apart and help you to achieve
                more.
            </p>

            <ul class="mt-8 space-y-4 text-left">
                <li class="flex items-start">
                    <Icon
                        name="lucide:check-circle"
                        class="size-5 text-green-500 mt-1 mr-3 flex-shrink-0"
                    />
                    <span class="font-mono text-lg text-gray-800">
                        High Quality and Reliability
                    </span>
                </li>
                <li class="flex items-start">
                    <Icon
                        name="lucide:check-circle"
                        class="size-5 text-green-500 mt-1 mr-3 flex-shrink-0"
                    />
                    <span class="font-mono text-lg text-gray-800">
                        User-Friendly Interface
                    </span>
                </li>
                <li class="flex items-start">
                    <Icon
                        name="lucide:check-circle"
                        class="size-5 text-green-500 mt-1 mr-3 flex-shrink-0"
                    />
                    <span class="font-mono text-lg text-gray-800">
                        24/7 Customer Support
                    </span>
                </li>
                <li class="flex items-start">
                    <Icon
                        name="lucide:check-circle"
                        class="size-5 text-green-500 mt-1 mr-3 flex-shrink-0"
                    />
                    <span class="font-mono text-lg text-gray-800">
                        Affordable Pricing Plans
                    </span>
                </li>
            </ul>
            <div class="mt-8 flex justify-end align-bottom">
                <button
                    class="bg-green-500 text-white font-mono py-2 px-4 rounded"
                >
                    Discover More
                </button>
            </div>
        </div>
    </div>
</section>

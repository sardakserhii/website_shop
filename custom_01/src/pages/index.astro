---
import Hero from "src/components/Hero.astro";
import Logos from "src/components/Logos.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Benefits from "src/components/Benefits.astro";
import { Icon } from "astro-icon/components";
import Carousel from "src/components/Carousel.astro";
import Specifiction from "src/components/Specifiction.astro";
import Testemonial from "src/components/Testemonial.astro";
import Howitwork from "src/components/Howitwork.astro";
import HeroBottom from "src/components/HeroBottom.astro";

const seo = {
    title: "Home — Astro Starter",
    description: "Clean Astro + Tailwind baseline to start shipping fast.",
};
---

<BaseLayout {...seo}>
    <Hero />
    <Logos />
    <Benefits />
    <Carousel />
    <Specifiction />
    <Testemonial />
    <Howitwork />
    <HeroBottom />
</BaseLayout>

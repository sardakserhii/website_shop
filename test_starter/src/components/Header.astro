---
import { Icon } from "astro-icon/components";
import NavLink from "./NavLink.astro";
---
<header class="border-b border-white/10">
  <div class="container flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-semibold">
      <Icon name="lucide:asterisk" class="h-5 w-5" />
      <span>Astro Starter</span>
    </a>
    <nav class="flex items-center gap-2">
      <NavLink href="/" label="Home" />
      <NavLink href="/about" label="About" />
      <a
        href="https://github.com/"
        class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-sm bg-white/5 hover:bg-white/10"
        target="_blank" rel="noopener noreferrer"
      >
        <Icon name="simple-icons:github" class="h-4 w-4" /> GitHub
      </a>
    </nav>
  </div>
</header>

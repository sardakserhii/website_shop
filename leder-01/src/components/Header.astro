---

---

<!-- full width header with 3 sections , logo , navigation , and actions -->
<header class="w-full bg-white shadow-md">
    <div class="container mx-auto flex items-center justify-between py-4 px-6">
        <!-- Logo Section -->
        <div class="flex items-center space-x-4">
            <!-- logo image -->
            <img class="h-10 w-12" src="/logo-2.png" alt="LederShop Logo" />
            <a href="/" class="text-2xl font-bold text-gray-800">LederShop</a>
        </div>

        <!-- Navigation Section -->
        <nav class="hidden md:flex space-x-8">
            <a href="/" class="text-gray-600 hover:text-gray-800">Main</a>
            <a href="/about" class="text-gray-600 hover:text-gray-800"
                >Über uns</a
            >
            <a href="/contact" class="text-gray-600 hover:text-gray-800"
                >Kontakt</a
            >
        </nav>

        <!-- Actions Section -->
        <div class="flex items-center space-x-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <a href="/login" class="text-gray-600 hover:text-gray-800"
                >WhatsApp</a
            >
        </div>
    </div>
</header>

---

---

<!-- full width header with 3 sections , logo , navigation , and actions -->
<header class="w-full bg-white shadow-md">
    <div class="container mx-auto flex items-center justify-between py-4 px-6">
        <!-- Logo Section -->
        <div class="flex items-center space-x-4">
            <!-- logo image -->
            <img class="h-10 w-12" src="/logo-2.png" alt="LederShop Logo" />
            <a href="/" class="text-2xl font-bold text-gray-800">LederShop</a>
        </div>

        <!-- Navigation Section -->
        <nav class="hidden md:flex space-x-8">
            <a href="/products" class="text-gray-600 hover:text-gray-800"
                >Produkte</a
            >
            <a href="/about" class="text-gray-600 hover:text-gray-800"
                >Über uns</a
            >
            <a href="/contact" class="text-gray-600 hover:text-gray-800"
                >Kontakt</a
            >
        </nav>

        <!-- Actions Section -->
        <div class="flex items-center space-x-4">
            <a href="/cart" class="text-gray-600 hover:text-gray-800">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 9m5-9v9m4-9v9m1-13h2a2 2 0 012 2v1a2 2 0 01-2 2h-2m-6 0H5a2 2 0 01-2-2V6a2 2 0 012-2h2"
                    ></path>
                </svg>
            </a>
            <a href="/login" class="text-gray-600 hover:text-gray-800"
                >WhatsApp</a
            >
        </div>
    </div>
</header>

---

<section class="px-8 py-16 max-w-6xl mx-auto">
    <h2 class="text-center mb-12 text-3xl font-bold">
        Bestellung in 4 Schritten
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div
            class="relative text-center p-8 rounded-lg bg-white shadow-lg hover:shadow-xl transition-shadow duration-300 border border-gray-200"
        >
            <div
                class="w-16 h-16 rounded-full bg-gradient-to-br from-amber-400 to-amber-500 text-white flex items-center justify-center text-2xl font-bold mx-auto mb-4 shadow-md"
            >
                1
            </div>
            <h3 class="mb-3 text-xl font-semibold text-gray-800">
                Foto und Anfrage
            </h3>
            <p class="text-gray-600 leading-relaxed">
                Senden Sie uns ein Foto und Ihre Anfrage
            </p>
        </div>

        <div
            class="relative text-center p-8 rounded-lg bg-white shadow-lg hover:shadow-xl transition-shadow duration-300 border border-gray-200"
        >
            <div
                class="w-16 h-16 rounded-full bg-gradient-to-br from-amber-500 to-amber-600 text-white flex items-center justify-center text-2xl font-bold mx-auto mb-4 shadow-md"
            >
                2
            </div>
            <h3 class="mb-3 text-xl font-semibold text-gray-800">
                Beratung & Preis
            </h3>
            <p class="text-gray-600 leading-relaxed">
                Wir beraten Sie und erstellen ein Angebot
            </p>
        </div>

        <div
            class="relative text-center p-8 rounded-lg bg-white shadow-lg hover:shadow-xl transition-shadow duration-300 border border-gray-200"
        >
            <div
                class="w-16 h-16 rounded-full bg-gradient-to-br from-amber-600 to-amber-700 text-white flex items-center justify-center text-2xl font-bold mx-auto mb-4 shadow-md"
            >
                3
            </div>
            <h3 class="mb-3 text-xl font-semibold text-gray-800">Fertigung</h3>
            <p class="text-gray-600 leading-relaxed">
                Herstellung Ihres individuellen Produkts
            </p>
        </div>

        <div
            class="relative text-center p-8 rounded-lg bg-white shadow-lg hover:shadow-xl transition-shadow duration-300 border border-gray-200"
        >
            <div
                class="w-16 h-16 rounded-full bg-gradient-to-br from-amber-700 to-amber-800 text-white flex items-center justify-center text-2xl font-bold mx-auto mb-4 shadow-md"
            >
                4
            </div>
            <h3 class="mb-3 text-xl font-semibold text-gray-800">Übergabe</h3>
            <p class="text-gray-600 leading-relaxed">
                Abholung oder Lieferung Ihrer Bestellung
            </p>
        </div>
    </div>
</section>

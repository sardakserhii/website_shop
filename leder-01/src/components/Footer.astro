---
// Footer.astro
---

<footer class="bg-gray-800 text-white pt-10 pb-6 mt-auto">
    <div class="container max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
            <div>
                <h3 class="text-lg font-semibold mb-4">LEDER-SATTLEREI</h3>
                <p class="text-gray-300">
                    Professionelle Leder-Arbeiten für Ihr Fahrzeug im Raum
                    Heilbronn/Schwaigern
                </p>
            </div>

            <div>
                <h3 class="text-lg font-semibold mb-4">Leistungen</h3>
                <ul class="space-y-2">
                    <li>
                        <a
                            href="/"
                            class="text-gray-300 hover:text-white hover:underline"
                            >Lenkrad beziehen</a
                        >
                    </li>
                    <li>
                        <a
                            href="/products"
                            class="text-gray-300 hover:text-white hover:underline"
                            >Sitze & Alcantara</a
                        >
                    </li>
                    <li>
                        <a
                            href="/about"
                            class="text-gray-300 hover:text-white hover:underline"
                            >Kopfstützen & Kissen</a
                        >
                    </li>
                    <li>
                        <a
                            href="/contact"
                            class="text-gray-300 hover:text-white hover:underline"
                            >Autointerieur</a
                        >
                    </li>
                </ul>
            </div>

            <div>
                <h3 class="text-lg font-semibold mb-4">Kontakt</h3>
                <p class="text-gray-300">Email: info@leder-sattlerei.de</p>
                <p class="text-gray-300">Telefon: +49 123 456 7890</p>
                <p class="text-gray-300">
                    Adresse: Musterstraße 1, 74193 Schwaigern
                </p>
            </div>
        </div>

        <div class="text-center pt-4 border-t border-gray-600">
            <p class="text-gray-400">
                &copy; {new Date().getFullYear()} Leder-Sattlerei Heilbronn/Schwaigern.
                <br />
                Alle Rechte vorbehalten. Schnelle Ausführung · Foto-Bericht · Garantie
            </p>
        </div>
    </div>
</footer>

<style>
    :global(html, body) {
        height: 100%;
    }
    :global(body) {
        display: flex;
        flex-direction: column;
    }
    :global(main) {
        flex: 1;
    }
</style>

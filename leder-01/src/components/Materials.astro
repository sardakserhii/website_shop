---

---

<!-- full width section for materials and farben -->
<section class="w-full bg-gray-50 py-8">
    <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">
            Materialien & Farben
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Material 1 -->
            <div class="bg-white p-4 rounded-lg shadow-lg border border-gray-200">
                <img
                    src="/materialen_example/leather.avif"
                    alt="Leder"
                    class="w-full h-48 object-cover rounded-md mb-4"
                />
                <h3 class="text-xl font-semibold text-gray-800 mb-2">Leder</h3>
                <p class="text-gray-600">
                    Hochwertiges Leder in verschiedenen Farben und Texturen.
                </p>
            </div>
            <!-- Material 2 -->
            <div class="bg-white p-4 rounded-lg shadow-lg border border-gray-200">
                <img
                    src="/materialen_example/stoff.avif"
                    alt="Stoff"
                    class="w-full h-48 object-cover rounded-md mb-4"
                />
                <h3 class="text-xl font-semibold text-gray-800 mb-2">Stoff</h3>
                <p class="text-gray-600">
                    Weiche und strapazierfähige Stoffe für vielseitige
                    Anwendungen.
                </p>
            </div>
            <!-- Material 3 -->
            <div class="bg-white p-4 rounded-lg shadow-lg border border-gray-200">
                <img
                    src="/materialen_example/wild.avif"
                    alt="Wildleder"
                    class="w-full h-48 object-cover rounded-md mb-4"
                />
                <h3 class="text-xl font-semibold text-gray-800 mb-2">
                    Wildleder
                </h3>
                <p class="text-gray-600">
                    Luxuriöses Wildleder in einer Vielzahl von Farbtönen.
                </p>
            </div>
            <!-- block with farben example -->
            <div class="bg-white p-6 rounded-lg shadow-lg border border-gray-200 md:col-span-3">
                <h3 class="text-xl font-semibold text-gray-800 mb-4">
                    Farbpalette
                </h3>
                <div class="flex flex-wrap gap-3 justify-center">
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-red-600 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Rot</span>
                    </button>
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-blue-600 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Blau</span>
                    </button>
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-green-600 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Grün</span>
                    </button>
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-yellow-600 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Gelb</span>
                    </button>
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-gray-800 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Grau</span>
                    </button>
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-purple-600 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Lila</span>
                    </button>
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-pink-600 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Pink</span>
                    </button>
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-indigo-600 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Indigo</span>
                    </button>
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-orange-600 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Orange</span>
                    </button>
                    <button
                        class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-300 rounded-full hover:shadow-lg hover:border-gray-400 transition-all"
                    >
                        <div class="w-8 h-8 bg-teal-600 rounded-full border-2 border-gray-200"></div>
                        <span class="text-sm font-medium text-gray-800">Türkis</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

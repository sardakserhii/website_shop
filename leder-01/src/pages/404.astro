---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Kontakt"
    description="Kontaktieren Sie uns - Adresse, Telefon, E-Mail und Öffnungszeiten"
>
    <div class="container mx-auto px-4 py-12">
        <h1 class="text-4xl font-bold text-gray-800 mb-8">Kontakt</h1>

        <div class="flex flex-col md:flex-row gap-8">
            <!-- Left: Contact Information -->
            <div class="flex-1">
                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h2 class="text-2xl font-semibold mb-4">
                        Kontaktinformationen
                    </h2>

                    <div class="flex flex-col gap-4">
                        <!-- Address -->
                        <div class="flex items-start">
                            <svg
                                class="w-6 h-6 text-blue-600 mr-3 mt-1 flex-shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <div class="flex-1">
                                <h3 class="font-semibold">Adresse</h3>
                                <p class="text-gray-600">
                                    Musterstraße 123<br />12345 Musterstadt
                                </p>
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="flex items-start">
                            <svg
                                class="w-6 h-6 text-blue-600 mr-3 mt-1 flex-shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path>
                            </svg>
                            <div class="flex-1">
                                <h3 class="font-semibold">Telefon</h3>
                                <a
                                    href="tel:+491234567890"
                                    class="text-blue-600 hover:underline"
                                    >+49 123 456 7890</a
                                >
                            </div>
                        </div>

                        <!-- WhatsApp -->
                        <div class="flex items-start">
                            <svg
                                class="w-6 h-6 text-green-600 mr-3 mt-1 flex-shrink-0"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                                ></path>
                            </svg>
                            <div class="flex-1">
                                <h3 class="font-semibold">WhatsApp</h3>
                                <a
                                    href="https://wa.me/491234567890"
                                    target="_blank"
                                    class="text-green-600 hover:underline"
                                    >+49 123 456 7890</a
                                >
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="flex items-start">
                            <svg
                                class="w-6 h-6 text-blue-600 mr-3 mt-1 flex-shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                            <div class="flex-1">
                                <h3 class="font-semibold">E-Mail</h3>
                                <a
                                    href="mailto:info@beispiel.de"
                                    class="text-blue-600 hover:underline"
                                    >info@beispiel.de</a
                                >
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Working Hours -->
                <div
                    class="flex items-start bg-white p-6 mt-6 rounded-lg shadow-md"
                >
                    <svg
                        class="w-6 h-6 text-blue-600 mr-3 mt-1 flex-shrink-0"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                    <div class="flex-1">
                        <h3 class="font-semibold">Arbeitszeit</h3>
                        <p class="text-gray-600">
                            Mo-Fr: 09:00 - 18:00 Uhr<br />
                            Sa: 10:00 - 14:00 Uhr<br />
                            So: Geschlossen
                        </p>
                    </div>
                </div>
            </div>

            <!-- Right: Google Maps -->
            <div class="flex-1 rounded-lg overflow-hidden shadow-md">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2428.409860333942!2d13.404954!3d52.520008!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a851c655f20989%3A0x26bbfb4e84674c63!2sBrandenburger%20Tor!5e0!3m2!1sde!2sde!4v1234567890"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Google Maps Standort"
                >
                </iframe>
            </div>
        </div>
    </div>
</BaseLayout>

---
import texts from "../data/texts.de.json";
---

<section id="über-uns" class="section bg-[#F3F4F6] text-[#101C26]">
    <div class="container grid md:grid-cols-2 gap-8 items-center">
        <div class="card aspect-video bg-white/5">
            <img
                src="/crash.avif"
                alt="Über uns Illustration"
                class="w-full h-auto rounded-2xl"
            />
        </div>
        <div class="space-y-3">
            <span class="badge">{texts.about.badge}</span>
            <h2 class="h2">{texts.about.title}</h2>
            <p class="text-lg md:text-xl">{texts.about.text}</p>
            <!-- <a class="button-secondary">{texts.about.cta}</a> -->
        </div>
    </div>
</section>

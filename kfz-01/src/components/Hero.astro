---
import texts from "../data/texts.de.json";
import { siteMeta } from "../config/site";
import { Image } from "astro:assets";
const title = texts.hero.title.replace("{city}", siteMeta.city);
---

<section
    id="start"
    class="section bg-gradient-to-b from-[#243e53] to-[#101C26]/80 text-white"
>
    <!-- <div class="container grid md:grid-cols-[1.2fr_.8fr] gap-8 items-center"> -->
    <div class="container flex items-stretch justify-between gap-8">
        <div class="space-y-4 flex flex-col justify-between">
            <div class="space-y-4">
                <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">
                    {title}
                </h1>
                <p class="lead text-white/70">{texts.hero.sub}</p>
            </div>
            <div class="flex gap-3">
                <a
                    class="px-10 py-2 bg-[#F0E714] text-[#101C26] rounded-[2px] hover:bg-yellow-500 text-sm font-medium"
                    href="#termin">{texts.hero.cta1}</a
                >
                <a
                    class="px-10 py-2 bg-[#F0E714] text-[#101C26] rounded-[2px] hover:bg-yellow-500 text-sm font-medium"
                    href="#kontakt">{texts.hero.cta2}</a
                >
            </div>
            <div class="grid grid-cols-3 gap-4 pt-4">
                {
                    texts.hero.stats.map((s) => (
                        <div class="card p-4 text-center">
                            <div class="text-2xl font-bold">{s.value}</div>
                            <div class="text-xs text-white/70">{s.label}</div>
                        </div>
                    ))
                }
            </div>
        </div>
        <div
            class="card hidden lg:flex aspect-video bg-white/5 flex items-center justify-center w-1/2"
        >
            <img
                src="/photo-werkstatt.avif"
                alt="Auto Werkstatt Illustration"
                class="w-full h-auto rounded-2xl"
            />
        </div>
    </div>
</section>

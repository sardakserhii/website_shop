---
import texts from "../data/texts.de.json";
---

<section
    class="py-8 bg-[#0F1115] bg-gradient-to-b from-[#101C26] to-[#101C26]/80 text-white"
>
    <div
        class="container flex flex-col md:flex-row items-center justify-between gap-4"
    >
        <div class="text-white/60 text-sm">{texts.trust}</div>
        <div class="flex items-center gap-4 opacity-70 text-3xl">
            <span>ATU</span><span>Continental</span><span>BOSCH</span><span
                >DEKRA</span
            >
        </div>
    </div>
</section>
